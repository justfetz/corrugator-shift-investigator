# Optional server-side key. The application reads the process environment;
# it does not auto-load this example or any .env file.
OPENAI_API_KEY=

# Hosted-demo Anthropic planner (docs/ANTHROPIC_DEMO.md). Server-held key only;
# public mode also needs PUBLIC_DEMO_LIVE_MODEL=1. Never commit a real value.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5        # or claude-sonnet-5-5

# Demo guards, all OFF unless set:
# DEMO_RATE_LIMIT_PER_MIN=20              # /api/ask rounds per client IP per minute -> 429 rate_limited
# DEMO_DAILY_CAP=400                      # live-model rounds per UTC day for everyone -> 429 budget
# DEMO_MAX_TURNS=14                       # question/scope entries carried to the next question (default 4)
# TRUST_PROXY=1                           # read the rightmost X-Forwarded-For entry (Cloud Run); never without a proxy
