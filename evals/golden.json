      "note": "Seeded story 1 (stories.SLITTER_REBUILD, never read by the agent): after the 20 August PM window, trim creeps about 0.1 pp a week and knife / slitter jams rise, concentrating on the slitter/scorer. At month grain the slitter's MINUTES fall because August holds the 180-minute PM window itself, so the place evidence is its stop count. The prose may say the rise coincides with the rebuild week and warrants inspection; it may not call the rebuild the cause, because nothing in the evidence establishes one.",
      "expect": {
        "status": "complete",
        "evidence": [
          {"tool": "get_trend", "arguments": {"metric": "trim_pct"}, "rows": "rows", "row": {"week_start": "2026-09-28"}, "field": "value",
           "change_from": {"row": {"week_start": "2026-08-17"}, "min": 0.4},
           "why": "the trim trend shows the week of 17 August and rises at least 0.4 pp by the week of 28 September"},
          {"tool": "get_downtime_pareto", "arguments": {"group_by": "reason"}, "window_covers": ["2026-09-01", "2026-09-30"],
           "row": {"category": "Knife / slitter jam"}, "field": "minutes", "at_least_times": {"field": "previous_minutes", "factor": 1.3},
           "why": "knife / slitter jam minutes in September are at least 1.3x August"},
          {"tool": "get_downtime_pareto", "arguments": {"group_by": "place"}, "window_covers": ["2026-09-01", "2026-09-30"],
           "row": {"category": "Slitter/scorer"}, "field": "stops", "at_least_times": {"field": "previous_stops", "factor": 1.5},
           "why": "slitter/scorer stop count in September is at least 1.5x August (its minutes fall: August holds the PM rebuild window)"}
        ],
        "prose_numbers": [
          {"evidence": 0, "field": "value"},
          {"evidence": 1, "field": "minutes"},
          {"evidence": 1, "field": "previous_minutes"},
          {"evidence": 2, "field": "stops"}
        ],
        "forbidden": [
          "\\b(slitter|rebuild|rebuilt)\\b[^.;]*\\b(caused|causes|causing|cause of|the cause|root cause|due to|because of|explains|explained|to blame|blamed|responsible for|attributable to)\\b",
          "\\b(caused by|due to|because of|root cause|explained by|blamed on|attributable to|result of)\\b[^.;]*\\b(slitter|rebuild|rebuilt)\\b"
        ],
        "max_cost_usd": 0.05
      }
