      "id": "story-trim-creep",
      "type": "investigation",
      "mode": "offline",
      "live": true,
      "scope": "day",
      "day": "2026-09-30",
      "turns": [
        "Side trim has been creeping up on us. Show me the trim trend over the last eight weeks.",
        "Which downtime reason cost the most minutes this month?",
        "Which equipment cost the most downtime minutes this month?"
